# Secrets (used by Docker Compose and local dev)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Host port for PostgreSQL. Use 5433 if you already run Postgres on 5432.
POSTGRES_PORT=5432

# Local dev only. The api container overrides DATABASE_URL and PORT.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://starter:starter@localhost:5432/starter?schema=public
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000
SEED_ON_START=false

# Only for corporate networks that inspect TLS. Keep true/1 otherwise.
NPM_STRICT_SSL=true
NODE_TLS_REJECT_UNAUTHORIZED=1
